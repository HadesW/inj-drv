<?xml version="1.0" encoding="utf-8"?>
<!--
  crtsys.lib built from the in-tree runtime (..\third\crtsys), as the CMake
  target "crtsys" did in the original inj-drv project:
    - crtsys sources, plus raw_pdb (..\third\raw_pdb) compiled with
      raw_pdb_kernel_compat.h force-included;
    - MSVC STL / vcruntime / UCRT sources pulled in through the four
      crtsys\src\*.props sheets (CMake attached them as VS_USER_PROPS).
    - Windows 10 RS5 header baseline (_NT_TARGET_VERSION 0xA000006), the same
      one the driver uses. The CMake build compiled this library against
      WINVER 0x0602; this WDK rejects WDM projects below Windows 10 (KMDF
      validation), so the VS build uses the official crtsys VS baseline.
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{8C50C9C4-6351-42F1-BD9E-0C38A18B82B6}</ProjectGuid>
    <RootNamespace>crtsys</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <_NT_TARGET_VERSION>0xA000006</_NT_TARGET_VERSION>
    <!-- crtsys uses C++ exceptions (/EHsc), which the WDK /kernel flag forbids; same as crtsys.targets. -->
    <DisableKernelFlag>true</DisableKernelFlag>
    <!-- Imported crtsys CRT props use wildcard ClCompile items, which the VC project system does not support.
         Read-only keeps the IDE quiet (no load warning) for this build-glue library project. -->
    <ReadOnlyProject>true</ReadOnlyProject>
  </PropertyGroup>
  <PropertyGroup Label="InjectorPaths">
    <CrtSysRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\third\crtsys\'))</CrtSysRoot>
    <LdkRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\third\ldk\'))</LdkRoot>
    <RawPdbRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\third\raw_pdb\'))</RawPdbRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Debug'">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Desktop</DriverTargetPlatform>
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- All projects share one cache\ and bin\ tree under the injector folder. -->
    <InjectorOutDir>$(SolutionDir)..\bin\</InjectorOutDir>
    <InjectorCacheDir>$(SolutionDir)..\cache\</InjectorCacheDir>
    <OutDir>$(InjectorOutDir)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(InjectorCacheDir)$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="Exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
    <Import Project="$(CrtSysRoot)src\stl.props" Condition="Exists('$(CrtSysRoot)src\stl.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(CrtSysRoot)src\vcruntime.props" Condition="Exists('$(CrtSysRoot)src\vcruntime.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(CrtSysRoot)src\custom\msvc\crt.props" Condition="Exists('$(CrtSysRoot)src\custom\msvc\crt.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(CrtSysRoot)src\ucrt.props" Condition="Exists('$(CrtSysRoot)src\ucrt.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Order matters: the WDK toolset appends its km\crt directory after %(AdditionalIncludeDirectories);
           the MSVC and Windows SDK directories must come before it, or <new> resolves to the km copy. -->
      <AdditionalIncludeDirectories>$(CrtSysRoot)src\custom\ucrt\$(WindowsTargetPlatformVersion)\inc;$(CrtSysRoot)src\custom\ucrt\common\inc;$(CrtSysRoot)src\custom\winsdk\include\um\crtsys;$(LdkRoot)include\Ldk;$(VC_IncludePath);$(WindowsSDK_IncludePath);$(CrtSysRoot)src\custom\msvc\143\include;$(CrtSysRoot)src\custom\msvc\143\crt\src\vcruntime;$(CrtSysRoot)src\custom\msvc\143\crt\src\stl;$(RawPdbRoot)src;$(CrtSysRoot)include;$(WindowsSdkDir)Include\wdf\kmdf\1.15;$(LdkRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/external:I "$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\shared" /external:I "$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\km" /external:I "$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\km\crt" /FS %(AdditionalOptions)</AdditionalOptions>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <ExceptionHandling>Sync</ExceptionHandling>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <ForcedIncludeFiles>$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\shared\warning.h;$(CrtSysRoot)src\crtsys.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <PreprocessorDefinitions>_KERNEL32_;_ITERATOR_DEBUG_LEVEL=0;CRTSYS_USE_LIBCNTPR;CRTSYS_NEED_CRT_IOB_FUNC;CRTSYS_NEED_CRT_ABORT;CRTSYS_ENABLE_DIAGNOSTIC_BREAKPOINTS=0;_HAS_EXCEPTIONS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <!-- WDK toolsets default to wchar_t as a typedef; crtsys (and the MSVC STL it compiles) expects a builtin wchar_t. -->
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="ldk.vcxproj">
      <Project>{59A783FC-A3F8-4D06-964C-916D1BC95AE0}</Project>
    </ProjectReference>
  </ItemGroup>
